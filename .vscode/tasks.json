{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Delivery",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-pedantic",
                "main.c",
                "fila.c",
                "pilha.c",
                "-o",
                "delivery"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
